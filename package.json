{
  "name": "envision-mail",
  "version": "2.6.31",
  "private": true,
  "description": "Envision Mail \u2014 email + calendar for Envision DMS",
  "author": "Envision Mail",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "dev:desktop": "npm run build:web && electron .",
    "build": "npm run build:web",
    "build:web": "next build",
    "build:icons": "node scripts/generate-icons.mjs && npm run build:icns",
    "build:icns": "bash scripts/make-icns.sh",
    "start": "next start",
    "lint": "eslint",
    "pack:mac": "npm run build:icons && npm run build:web && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip && bash scripts/verify-asar.sh && bash scripts/clean-unpacked-apps.sh",
    "pack:win": "npm run build:icons && npm run build:web && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --x64 && bash scripts/clean-unpacked-apps.sh",
    "pack:all": "npm run build:icons && npm run build:web && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --win nsis --x64 && bash scripts/verify-asar.sh && bash scripts/clean-unpacked-apps.sh",
    "pack:release": "bash scripts/pack-release.sh",
    "verify:asar": "bash scripts/verify-asar.sh",
    "clean:unpacked": "bash scripts/clean-unpacked-apps.sh",
    "dist": "npm run pack:all",
    "uninstall:mac": "bash scripts/Uninstall-Envision-Mail.command"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "encoding-japanese": "2.2.0",
    "imapflow": "^1.0.199",
    "mailparser": "^3.7.4",
    "nodemailer": "^7.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lespaulporter-bit/Envision-Mail-Client.git"
  }
}
